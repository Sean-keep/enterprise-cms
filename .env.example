# ── 后端 ──────────────────────────────────────────────
# SQLite 文件路径，相对于 backend/prisma/ 目录解析。
# 改成绝对路径也可以（容器里见 docker-compose.yml）。
DATABASE_URL=file:./data/cms.db

# 后端监听
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# session cookie 的签名用途（本轮只做随机 token + 库存哈希，此项预留）
SESSION_SECRET=change-me-in-production
SESSION_TTL_DAYS=7

# 上传目录，相对于 backend/ 解析
UPLOAD_DIR=uploads

# ── 前端 ──────────────────────────────────────────────
# 官网对外的绝对地址，用于 canonical / OG / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:8890

# 后端 API 地址。容器内是服务名，宿主机开发时是 localhost
API_BASE_URL=http://localhost:4000

# 前端自己的地址，后端写内容后调它做 on-demand revalidate
WEB_BASE_URL=http://localhost:3000

# revalidate webhook 的共享密钥，后端调用时放在 x-revalidate-secret
REVALIDATE_SECRET=change-me-too
